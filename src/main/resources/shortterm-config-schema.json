
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mobitopp.kit.ifv.edu/schemas/myschema.json",
  "title": "Short Term Configuration for Mobitopp Runs.",
  "description": "Configuration for a mobitopp run usin gshared attributes",
  "required": ["scenarioName", "seed", "dataFolder", "fractionOfPopulation", "attractivitiesFile", "costMatrixConfigPath", "durationMatrixConfigPath", "distanceMatrixPath"],
  "type": "object",
  "properties": {
    "scenarioName": {
      "type": "string",
      "default": "unnamedShorttermScenario",
      "pattern": "^[a-zA-Z]*$"
    },
    "seed": {
      "description": "The standard seed",
      "type": "integer",
      "default": 42
    },
    "dataFolder": {
      "description": "",
      "type": "string",
      "default": "//ifv-fs/Forschung/Projekte_intern/mobitopp/Output/logiktram_rastatt_long-term-module/rastatt"
    },
    "fractionOfPopulation": {
      "description": "",
      "type": "number",
      "default": 1.0,
      "exclusiveMinimum": 0.0,
      "maximum": 1.0
    },
    "visumNetwork": {
      "description": "src/test/resources/rastatt.net",
      "type": "string"
    },
    "attractivitiesFile": {
      "description": "",
      "type": "string",
      "default": "data/attractivities.csv"
    },
    "costMatrixConfigPath": {
      "description": "",
      "type": "string"
    },
    "durationMatrixConfigPath": {
      "description": "",
      "type": "string"

    },
    "distanceMatrixPath": {
      "description": "",
      "type": "string"
    }
  }
}

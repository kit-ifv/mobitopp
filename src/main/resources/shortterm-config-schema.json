{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mobitopp.kit.ifv.edu/schemas/myschema.json",
  "title": "Short Term Configuration for Mobitopp Runs.",
  "description": "Configuration for a mobitopp run using shared attributes",
  "required": ["costMatrixConfigPath", "durationMatrixConfigPath", "distanceMatrixPath", "resultPath", "resultName", "errorHandling", "simulationContext"],
  "type": "object",
  "properties": {
    "costMatrixConfigPath": {
      "description": "",
      "type": "string"
    },
    "durationMatrixConfigPath": {
      "description": "",
      "type": "string"
    },
    "distanceMatrixPath": {
      "description": "",
      "type": "string"
    },
    "resultPath": {
      "description": "The directory, results are written to",
      "type": "string"
    },
    "resultName": {
      "description": "The name of the simulation output csv",
      "type": "string",
      "pattern": "^[a-z][a-zA-Z]*.csv$"
    },
    "errorHandling": {
      "description": "How errors during a simulation run should be treated.",
      "type": "string",
      "enum": ["SILENT", "WARNING", "ERROR", "THROW", "THROW_NO_LOG"]
    },
    "simulationContext": {
      "object": {
        "simulationSeed": {
          "type": "integer"
        },
        "scenarioName": {
          "type": "string"
        },
        "dataFolder": {
           "type": "string"
        },
        modes: HamburgModes # TODO with enum
        regionTypeCodes: safeRegioStaR17 # TODO with enum
        economicalStatusCodes: EconomicStatus  # TODO with enum

      }
    }
  }
}

ProbabilityClass edu.kit.ifv.mobitopp.simulation.modechoice.gen.GeneratedMixedModeChoice

Interface        edu.kit.ifv.mobitopp.simulation.modeChoice.ModeChoiceModel
Signature        selectMode(edu.kit.ifv.mobitopp.simulation.Person person,
              edu.kit.ifv.mobitopp.data.Zone origin >,
              edu.kit.ifv.mobitopp.data.Zone destination >,
              edu.kit.ifv.mobitopp.simulation.activityschedule.ActivityIfc previousActivity,
              edu.kit.ifv.mobitopp.simulation.activityschedule.ActivityIfc nextActivity,
              java.util.Set<edu.kit.ifv.mobitopp.simulation.Mode> choiceSet,
              double randomNumber):edu.kit.ifv.mobitopp.simulation.Mode
              
UtilityClass     edu.kit.ifv.mobitopp.simulation.modechoice.gen.GeneratedMixedUtilityFunction
HelperClass      edu.kit.ifv.mobitopp.simulation.modechoice.gen.MixedModeChoiceHelper


root: {
		<walk?U_walk>
		<bike?U_bike>
		<card?U_card>
		public_transport? {	<pt?U_pt>
							shuttle? {	<shuttle_od?U_shuttle_od>
												<shuttle_sh?U_shuttle_sh>} }
		intermodal? {	<pt_bike?U_pt_bike>
						<bike_pt?U_bike_pt>
						<bike_pt_bike?U_bike_pt_bike>
					//	<shuttle_od_pt_bike?U_shuttle_od_pt_bike?>
					//	<bike_pt_shuttle_od?U_bike_pt_shuttle_od>
				
						<pt_card?U_pt_card>
						<card_pt?U_card_pt>
					//	<shuttle_od_pt_card?U_shuttle_od_pt_card?>
					//	<card_pt_shuttle_od?U_card_pt_shuttle_od>
						
						<pt_shuttle_od?U_pt_shuttle_od>
						<shuttle_od_pt?U_shuttle_od_pt>
						
						<shuttle_sh_pt_shuttle_sh?U_shuttle_sh_pt_shuttle_sh> // in mobitopp nicht intermodal
						}

		}

// Lambdas?
// Macht es Sinn, Access und Degress zu trennen? Ja weil nur dann Fußwege zum ÖPNV korrekt in VISUM erzeugt. Außerdem Verfügbarkeit der Optionen besser definierbar.
// Wie mit mangelnden Daten umgehen für dreiteilige Wegeketten

Pedestrian: U_walk =  (	asc_fuss +
                     						// b_oek1_on_fuss * [(IS_HOUSEHOLD_ECONOMICAL_STATUS_VERY_LOW + IS_HOUSEHOLD_ECONOMICAL_STATUS_LOW )> 0] +
                     						// b_oek5_on_fuss * [(IS_HOUSEHOLD_ECONOMICAL_STATUS_VERY_HIGH + IS_HOUSEHOLD_ECONOMICAL_STATUS_HIGH )> 0] +
                     						b_pkw_haushalt_fuss * [HOUSEHOLD_NOMINAL_NUMBER_OF_CARS>0] +
                     						// b_RegioStaR2_land_fuss * [HOUSEHOLD_AREATYPE > 9 ] +

                     						// b_verfueg_rad_fuss * HAS_BIKE +
                     						bav_zeitoev_fuss * HAS_COMMUTER_TICKET +
                     						// b_male_fuss * IS_GENDER_MALE +
                     						// b_alter_0_29_fuss * [AGE<30] +
                     						// b_alter_30_39_fuss * [29<AGE<40] +
                     						// b_alter_40_59_fuss * [39<AGE<60]  +
                     						// b_alter_60_69_fuss * [59<AGE<70]  +
                     						// b_alter_70_fuss * [AGE>69] +

                     						b_arbeit_on_fuss * IS_ACTIVITY_TYPE_WORK  +
                     						b_freizeit_on_fuss * [(IS_ACTIVITY_TYPE_LEISURE_INDOOR + IS_ACTIVITY_TYPE_LEISURE_OUTDOOR + IS_ACTIVITY_TYPE_LEISURE_OTHER + IS_ACTIVITY_TYPE_PTIVATE_VISIT)>0]  +
                     						bfz_fuss * TRAVEL_TIME_PEDESTRIAN
                    )

           
Bike: U_bike = (	asc_rad +
               						// b_oek1_on_rad * [(IS_HOUSEHOLD_ECONOMICAL_STATUS_VERY_LOW + IS_HOUSEHOLD_ECONOMICAL_STATUS_LOW )> 0] +
               						// b_oek5_on_rad * [(IS_HOUSEHOLD_ECONOMICAL_STATUS_VERY_HIGH + IS_HOUSEHOLD_ECONOMICAL_STATUS_HIGH )> 0] +
               						b_pkw_haushalt_rad * [HOUSEHOLD_NOMINAL_NUMBER_OF_CARS>0] +
               						b_RegioStaR2_land_rad * [HOUSEHOLD_AREATYPE > 9 ] +

               						// b_verfueg_rad_rad * HAS_BIKE +
               						// bav_zeitoev_rad * HAS_COMMUTER_TICKET +
               						// b_male_rad * IS_GENDER_MALE +
               						// b_alter_0_29_rad * [AGE<30] +
               						// b_alter_30_39_rad * [29<AGE<40] +
               						// b_alter_40_59_rad * [39<AGE<60]  +
               						// b_alter_60_69_rad * [59<AGE<70]  +
               						b_alter_70_rad * [AGE>69] +

               						b_arbeit_on_rad * IS_ACTIVITY_TYPE_WORK  +
               						b_freizeit_on_rad * [(IS_ACTIVITY_TYPE_LEISURE_INDOOR + IS_ACTIVITY_TYPE_LEISURE_OUTDOOR + IS_ACTIVITY_TYPE_LEISURE_OTHER + IS_ACTIVITY_TYPE_PTIVATE_VISIT)>0]  +
               						bfz_rad * TRAVEL_TIME_BIKE
               						)


Car: U_card = (	asc_car +
              						// b_oek1_on_car * [(IS_HOUSEHOLD_ECONOMICAL_STATUS_VERY_LOW + IS_HOUSEHOLD_ECONOMICAL_STATUS_LOW )> 0] +
              						// b_oek5_on_car * [(IS_HOUSEHOLD_ECONOMICAL_STATUS_VERY_HIGH + IS_HOUSEHOLD_ECONOMICAL_STATUS_HIGH )> 0] +
              						b_pkw_haushalt_car * [HOUSEHOLD_NOMINAL_NUMBER_OF_CARS>0] +
              						b_RegioStaR2_land_car * [HOUSEHOLD_AREATYPE > 9 ] +

              						// b_verfueg_rad_car * HAS_BIKE +
              						bav_zeitoev_car * HAS_COMMUTER_TICKET +
              						// b_male_car * IS_GENDER_MALE +
              						// b_alter_0_29_car * [AGE<30] +
              						// b_alter_30_39_car * [29<AGE<40] +
              						// b_alter_40_59_car * [39<AGE<60]  +
              						// b_alter_60_69_car * [59<AGE<70]  +
              						// b_alter_70_car * [AGE>69] +

              						b_arbeit_on_car * IS_ACTIVITY_TYPE_WORK  +
              						b_freizeit_on_car * [(IS_ACTIVITY_TYPE_LEISURE_INDOOR + IS_ACTIVITY_TYPE_LEISURE_OUTDOOR + IS_ACTIVITY_TYPE_LEISURE_OTHER + IS_ACTIVITY_TYPE_PTIVATE_VISIT)>0]  +
              						bfz_car * TRAVEL_TIME_CAR +
              						bfz_fuss2car * PARKING_STRESS +
              						(bcost_car * (TRAVEL_COST_CAR + PARKING_COST))
              						)


PublicTransport0: U_pt = (	asc_oev_fuss +
                        						// b_oek1_on_oev_fuss * [(IS_HOUSEHOLD_ECONOMICAL_STATUS_VERY_LOW + IS_HOUSEHOLD_ECONOMICAL_STATUS_LOW )> 0] +
                        						// b_oek5_on_oev_fuss * [(IS_HOUSEHOLD_ECONOMICAL_STATUS_VERY_HIGH + IS_HOUSEHOLD_ECONOMICAL_STATUS_HIGH )> 0] +
                        						b_pkw_haushalt_oev_fuss * [HOUSEHOLD_NOMINAL_NUMBER_OF_CARS>0] +
                        						b_RegioStaR2_land_oev_fuss * [HOUSEHOLD_AREATYPE > 9 ] +

                        						// b_verfueg_rad_oev_fuss * HAS_BIKE +
                        						bav_zeitoev_oev_fuss * HAS_COMMUTER_TICKET +
                        						b_male_oev_fuss * IS_GENDER_MALE +
                        						// b_alter_0_29_oev_fuss * [AGE<30] +
                        						// b_alter_30_39_oev_fuss * [29<AGE<40] +
                        						// b_alter_40_59_oev_fuss * [39<AGE<60]  +
                        						// b_alter_60_69_oev_fuss * [59<AGE<70]  +
                        						// b_alter_70_oev_fuss * [AGE>69] +

                        						b_arbeit_on_oev_fuss * IS_ACTIVITY_TYPE_WORK  +
                        						b_freizeit_on_oev_fuss * [(IS_ACTIVITY_TYPE_LEISURE_INDOOR + IS_ACTIVITY_TYPE_LEISURE_OUTDOOR + IS_ACTIVITY_TYPE_LEISURE_OTHER + IS_ACTIVITY_TYPE_PTIVATE_VISIT)>0]  +
                        						bfz_oev_fuss * TRAVEL_TIME_PUBLICTRANSPORT +
                        						bfz_fuss2oev * TRAVEL_TIME_PUBLICTRANSPORT_ACCESS_DEGRESS +
                        						bcost_car * TRAVEL_COST_PUBLICTRANSPORT +
                        						bfreq_oev * FREQUENCY_PUBLICTRANSPORT
                        						)

Shuttle_SH: U_shuttle_sh = (	asc_shuttle_tb +
                           						b_oek1_on_shuttle_tb * [(IS_HOUSEHOLD_ECONOMICAL_STATUS_VERY_LOW + IS_HOUSEHOLD_ECONOMICAL_STATUS_LOW )> 0] +
                           						// b_oek5_on_shuttle_tb * [(IS_HOUSEHOLD_ECONOMICAL_STATUS_VERY_HIGH + IS_HOUSEHOLD_ECONOMICAL_STATUS_HIGH )> 0] +
                           						b_pkw_haushalt_shuttle_tb * [HOUSEHOLD_NOMINAL_NUMBER_OF_CARS>0] +
                           						//b_RegioStaR2_land_shuttle_tb * [HOUSEHOLD_AREATYPE > 9 ] +

                           						// b_verfueg_rad_shuttle_tb * HAS_BIKE +
                           						bav_zeitoev_shuttle_tb * HAS_COMMUTER_TICKET +
                           						//b_male_shuttle_tb * IS_GENDER_MALE +
                           						// b_alter_0_29_shuttle_tb * [AGE<30] +
                           						// b_alter_30_39_shuttle_tb * [29<AGE<40] +
                           						// b_alter_40_59_shuttle_tb * [39<AGE<60]  +
                           						// b_alter_60_69_shuttle_tb * [59<AGE<70]  +
                           						// b_alter_70_shuttle_tb * [AGE>69] +

                           						b_arbeit_on_shuttle_tb * IS_ACTIVITY_TYPE_WORK  +
                           						b_freizeit_on_shuttle_tb * [(IS_ACTIVITY_TYPE_LEISURE_INDOOR + IS_ACTIVITY_TYPE_LEISURE_OUTDOOR + IS_ACTIVITY_TYPE_LEISURE_OTHER + IS_ACTIVITY_TYPE_PTIVATE_VISIT)>0]  +
                           						bfz_shuttle_tb * TRAVEL_TIME_SHUTTLE_SH +
                           						bfz_fuss2oev * TRAVEL_TIME_SHUTTLE_SH_ACCESS_DEGRESS +
                           						bcost_car * TRAVEL_COST_SHUTTLE_SH +
                           						bfreq_oev * FREQUENCY_SHUTTLE_SH +

                           						(-99999) * [TRAVEL_SHARE_SHUTTLE_SH < 1]
                           						)


Shuttle_OD: U_shuttle_od = (	asc_shuttle_od +
                           						b_oek1_on_shuttle_od * [(IS_HOUSEHOLD_ECONOMICAL_STATUS_VERY_LOW + IS_HOUSEHOLD_ECONOMICAL_STATUS_LOW )> 0] +
                           						// b_oek5_on_shuttle_od * [(IS_HOUSEHOLD_ECONOMICAL_STATUS_VERY_HIGH + IS_HOUSEHOLD_ECONOMICAL_STATUS_HIGH )> 0] +
                           						b_pkw_haushalt_shuttle_od * [HOUSEHOLD_NOMINAL_NUMBER_OF_CARS>0] +
                           						// b_RegioStaR2_land_shuttle_od * [HOUSEHOLD_AREATYPE > 9 ] +

                           						// b_verfueg_rad_shuttle_od * HAS_BIKE +
                           						bav_zeitoev_shuttle_od * HAS_COMMUTER_TICKET +
                           						// b_male_shuttle_od * IS_GENDER_MALE +
                           						// b_alter_0_29_shuttle_od * [AGE<30] +
                           						// b_alter_30_39_shuttle_od * [29<AGE<40] +
                           						// b_alter_40_59_shuttle_od * [39<AGE<60]  +
                           						// b_alter_60_69_shuttle_od * [59<AGE<70]  +
                           						// b_alter_70_shuttle_od * [AGE>69] +

                           						b_arbeit_on_shuttle_od * IS_ACTIVITY_TYPE_WORK  +
                           						b_freizeit_on_shuttle_od * [(IS_ACTIVITY_TYPE_LEISURE_INDOOR + IS_ACTIVITY_TYPE_LEISURE_OUTDOOR + IS_ACTIVITY_TYPE_LEISURE_OTHER + IS_ACTIVITY_TYPE_PTIVATE_VISIT)>0]  +

                           						bfz_shuttle_od * TRAVEL_TIME_RIDEPOOLING +
                           						bcost_shuttle * TRAVEL_COST_RIDEPOOLING +
                           						bwt_acc_shuttle_od * WAITING_TIME_RIDE_POOLING +
                           						bfz_fuss2oev * ACCESS_TIME_RIDE_POOLING
                           						)


PublicTransport1: U_pt_bike= (	asc_oev_rad +
                            						// b_oek1_on_oev_rad * [(IS_HOUSEHOLD_ECONOMICAL_STATUS_VERY_LOW + IS_HOUSEHOLD_ECONOMICAL_STATUS_LOW )> 0] +
                            						// b_oek5_on_oev_rad * [(IS_HOUSEHOLD_ECONOMICAL_STATUS_VERY_HIGH + IS_HOUSEHOLD_ECONOMICAL_STATUS_HIGH )> 0] +
                            						b_pkw_haushalt_oev_rad * [HOUSEHOLD_NOMINAL_NUMBER_OF_CARS>0] +
                            						// b_RegioStaR2_land_oev_rad * [HOUSEHOLD_AREATYPE > 9 ] +

                            						// b_verfueg_rad_oev_rad * HAS_BIKE +
                            						bav_zeitoev_oev_rad * HAS_COMMUTER_TICKET +
                            						// b_male_oev_rad * IS_GENDER_MALE +
                            						b_alter_0_29_oev_rad * [AGE<30] +
                            						// b_alter_30_39_oev_rad * [29<AGE<40] +
                            						// b_alter_40_59_oev_rad * [39<AGE<60]  +
                            						// b_alter_60_69_oev_rad * [59<AGE<70]  +
                            						b_alter_70_oev_rad * [AGE>69] +

                            						b_arbeit_on_oev_rad * IS_ACTIVITY_TYPE_WORK  +
                            						b_freizeit_on_oev_rad * [(IS_ACTIVITY_TYPE_LEISURE_INDOOR + IS_ACTIVITY_TYPE_LEISURE_OUTDOOR + IS_ACTIVITY_TYPE_LEISURE_OTHER + IS_ACTIVITY_TYPE_PTIVATE_VISIT)>0]  +

                            						bfz_oev_fuss * TRAVEL_TIME_PUBLICTRANSPORT_MAIN +
                            						bcost_oev*TRAVEL_COST_PUBLICTRANSPORT_MAIN +
                            						bfreq_oev * FREQUENCY_PUBLICTRANSPORT_MAIN +
                            						bfz_rad2oev * TRAVEL_TIME_BIKE_DEGRESS
                            						)

PublicTransport2: U_bike_pt = (	asc_oev_rad +
                             						// b_oek1_on_oev_rad * [(IS_HOUSEHOLD_ECONOMICAL_STATUS_VERY_LOW + IS_HOUSEHOLD_ECONOMICAL_STATUS_LOW )> 0] +
                             						// b_oek5_on_oev_rad * [(IS_HOUSEHOLD_ECONOMICAL_STATUS_VERY_HIGH + IS_HOUSEHOLD_ECONOMICAL_STATUS_HIGH )> 0] +
                             						b_pkw_haushalt_oev_rad * [HOUSEHOLD_NOMINAL_NUMBER_OF_CARS>0] +
                             						// b_RegioStaR2_land_oev_rad * [HOUSEHOLD_AREATYPE > 9 ] +

                             						// b_verfueg_rad_oev_rad * HAS_BIKE +
                             						bav_zeitoev_oev_rad * HAS_COMMUTER_TICKET +
                             						// b_male_oev_rad * IS_GENDER_MALE +
                             						b_alter_0_29_oev_rad * [AGE<30] +
                             						// b_alter_30_39_oev_rad * [29<AGE<40] +
                             						// b_alter_40_59_oev_rad * [39<AGE<60]  +
                             						// b_alter_60_69_oev_rad * [59<AGE<70]  +
                             						b_alter_70_oev_rad * [AGE>69] +

                             						b_arbeit_on_oev_rad * IS_ACTIVITY_TYPE_WORK  +
                             						b_freizeit_on_oev_rad * [(IS_ACTIVITY_TYPE_LEISURE_INDOOR + IS_ACTIVITY_TYPE_LEISURE_OUTDOOR + IS_ACTIVITY_TYPE_LEISURE_OTHER + IS_ACTIVITY_TYPE_PTIVATE_VISIT)>0]  +

                             						bfz_oev * TRAVEL_TIME_PUBLICTRANSPORT +
                             						bcost_oev*TRAVEL_COST_PUBLICTRANSPORT +
                             						bfreq_oev * FREQUENCY_PUBLICTRANSPORT +
                             						bfz_rad2oev * TRAVEL_TIME_BIKE
                             						)

PublicTransport3: U_bike_pt_bike = (	asc_oev_rad +
                                  						// b_oek1_on_oev_rad * [(IS_HOUSEHOLD_ECONOMICAL_STATUS_VERY_LOW + IS_HOUSEHOLD_ECONOMICAL_STATUS_LOW )> 0] +
                                  						// b_oek5_on_oev_rad * [(IS_HOUSEHOLD_ECONOMICAL_STATUS_VERY_HIGH + IS_HOUSEHOLD_ECONOMICAL_STATUS_HIGH )> 0] +
                                  						b_pkw_haushalt_oev_rad * [HOUSEHOLD_NOMINAL_NUMBER_OF_CARS>0] +
                                  						// b_RegioStaR2_land_oev_rad * [HOUSEHOLD_AREATYPE > 9 ] +

                                  						// b_verfueg_rad_oev_rad * HAS_BIKE +
                                  						bav_zeitoev_oev_rad * HAS_COMMUTER_TICKET +
                                  						// b_male_oev_rad * IS_GENDER_MALE +
                                  						b_alter_0_29_oev_rad * [AGE<30] +
                                  						// b_alter_30_39_oev_rad * [29<AGE<40] +
                                  						// b_alter_40_59_oev_rad * [39<AGE<60]  +
                                  						// b_alter_60_69_oev_rad * [59<AGE<70]  +
                                  						b_alter_70_oev_rad * [AGE>69] +

                                  						b_arbeit_on_oev_rad * IS_ACTIVITY_TYPE_WORK  +
                                  						b_freizeit_on_oev_rad * [(IS_ACTIVITY_TYPE_LEISURE_INDOOR + IS_ACTIVITY_TYPE_LEISURE_OUTDOOR + IS_ACTIVITY_TYPE_LEISURE_OTHER + IS_ACTIVITY_TYPE_PTIVATE_VISIT)>0]  +

                                  						bfz_oev * TRAVEL_TIME_PUBLICTRANSPORT +
                                  						bcost_oev*TRAVEL_COST_PUBLICTRANSPORT +
                                  						bfreq_oev * FREQUENCY_PUBLICTRANSPORT +
                                  						bfz_rad2oev * TRAVEL_TIME_BIKE + //Access
                                  						bfz_rad2oev * TRAVEL_TIME_BIKE // Degress
                                  						)

PublicTransport4: U_pt_card = (	asc_oev_car +
                             						// b_oek1_on_oev_car * [(IS_HOUSEHOLD_ECONOMICAL_STATUS_VERY_LOW + IS_HOUSEHOLD_ECONOMICAL_STATUS_LOW )> 0] +
                             						// b_oek5_on_oev_car * [(IS_HOUSEHOLD_ECONOMICAL_STATUS_VERY_HIGH + IS_HOUSEHOLD_ECONOMICAL_STATUS_HIGH )> 0] +
                             						// b_pkw_haushalt_oev_car * [HOUSEHOLD_NOMINAL_NUMBER_OF_CARS>0] +
                             						// b_RegioStaR2_land_oev_car * [HOUSEHOLD_AREATYPE > 9 ] +

                             						// b_verfueg_car_oev_car * HAS_BIKE +
                             						bav_zeitoev_oev_car * HAS_COMMUTER_TICKET +
                             						// b_male_oev_car * IS_GENDER_MALE +
                             						// b_alter_0_29_oev_car * [AGE<30] +
                             						// b_alter_30_39_oev_car * [29<AGE<40] +
                             						// b_alter_40_59_oev_car * [39<AGE<60]  +
                             						// b_alter_60_69_oev_car * [59<AGE<70]  +
                             						// b_alter_70_oev_car * [AGE>69] +

                             						// b_arbeit_on_oev_car * IS_ACTIVITY_TYPE_WORK  +
                             						// b_freizeit_on_oev_car * [(IS_ACTIVITY_TYPE_LEISURE_INDOOR + IS_ACTIVITY_TYPE_LEISURE_OUTDOOR + IS_ACTIVITY_TYPE_LEISURE_OTHER + IS_ACTIVITY_TYPE_PTIVATE_VISIT)>0]  +

                             						bfz_oev *  TRAVEL_TIME_PUBLICTRANSPORT +
                             						bcost_oev* TRAVEL_COST_PUBLICTRANSPORT +
                             						bfreq_oev * FREQUENCY_PUBLICTRANSPORT +
                             						bfz_car2oev * TRAVEL_TIME_CAR +
                             						bcost_oev * TRAVEL_COST_CAR
                             						)

PublicTransport5: U_card_pt = (	asc_oev_car +
                             						// b_oek1_on_oev_car * [(IS_HOUSEHOLD_ECONOMICAL_STATUS_VERY_LOW + IS_HOUSEHOLD_ECONOMICAL_STATUS_LOW )> 0] +
                             						// b_oek5_on_oev_car * [(IS_HOUSEHOLD_ECONOMICAL_STATUS_VERY_HIGH + IS_HOUSEHOLD_ECONOMICAL_STATUS_HIGH )> 0] +
                             						// b_pkw_haushalt_oev_car * [HOUSEHOLD_NOMINAL_NUMBER_OF_CARS>0] +

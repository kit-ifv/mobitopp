                             						// b_alter_40_59_oev_car * [39<AGE<60]  +
                             						// b_alter_60_69_oev_car * [59<AGE<70]  +
                             						// b_alter_70_oev_car * [AGE>69] +

                             						// b_arbeit_on_oev_car * IS_ACTIVITY_TYPE_WORK  +
                             						// b_freizeit_on_oev_car * [(IS_ACTIVITY_TYPE_LEISURE_INDOOR + IS_ACTIVITY_TYPE_LEISURE_OUTDOOR + IS_ACTIVITY_TYPE_LEISURE_OTHER + IS_ACTIVITY_TYPE_PTIVATE_VISIT)>0]  +

                             						bfz_oev * TRAVEL_TIME_PUBLICTRANSPORT +
                             						bcost_oev*TRAVEL_COST_PUBLICTRANSPORT +
                             						bfreq_oev * FREQUENCY_PUBLICTRANSPORT +
                             						bfz_car2oev * TRAVEL_TIME_CAR +
                             						bcost_oev * TRAVEL_COST_CAR
                             						)


PublicTransport6: U_pt_shuttle_od = (	asc_oev_shuttle_od +
                                   						// b_oek1_on_oev_shuttle_od * [(IS_HOUSEHOLD_ECONOMICAL_STATUS_VERY_LOW + IS_HOUSEHOLD_ECONOMICAL_STATUS_LOW )> 0] +
                                   						// b_oek5_on_oev_shuttle_od * [(IS_HOUSEHOLD_ECONOMICAL_STATUS_VERY_HIGH + IS_HOUSEHOLD_ECONOMICAL_STATUS_HIGH )> 0] +
                                   						b_pkw_haushalt_oev_shuttle_od * [HOUSEHOLD_NOMINAL_NUMBER_OF_CARS>0] +
                                   						b_RegioStaR2_land_oev_shuttle_od * [HOUSEHOLD_AREATYPE > 9 ] +

                                   						// b_verfueg_rad_oev_shuttle_od * HAS_BIKE +
                                   						bav_zeitoev_oev_shuttle_od * HAS_COMMUTER_TICKET +
                                   						// b_male_oev_shuttle_od * IS_GENDER_MALE +
                                   						// b_alter_0_29_oev_shuttle_od * [AGE<30] +
                                   						// b_alter_30_39_oev_shuttle_od * [29<AGE<40] +
                                   						// b_alter_40_59_oev_shuttle_od * [39<AGE<60]  +
                                   						// b_alter_60_69_oev_shuttle_od * [59<AGE<70]  +
